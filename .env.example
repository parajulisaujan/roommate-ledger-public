# Copy to .env at the repository root. Choose a strong local database password.
DATABASE_PASSWORD=replace-with-a-long-random-password
DATABASE_USER=roommateledger
DATABASE_URL=postgresql+psycopg://localhost:5432/roommateledger
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CORS_ALLOWED_ORIGINS=
RECEIPT_PROVIDER_URL=
RECEIPT_PROVIDER_API_KEY=

# Development is the local default; staging/production require HTTPS and working SMTP.
APP_ENV=development
FRONTEND_URL=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:8080
SESSION_TIMEOUT_SECONDS=1800
# Trust only the actual reverse proxy addresses/CIDRs; empty ignores forwarded IPs.
TRUSTED_PROXY_CIDRS=
# Optional origin gate for a protected frontend with an internet-routable API.
# Generate/store a real key privately in host secrets, never in this template.
DEPLOYMENT_PROXY_REQUIRED=false
DEPLOYMENT_PROXY_KEY=
# Native/container backend listener (Compose keeps its internal port at 8080).
HOST=0.0.0.0
PORT=8080

# Choose adapter or openai. OpenAI requires both a server key and a supported vision model.
RECEIPT_PROVIDER=adapter
OPENAI_API_KEY=
OPENAI_RECEIPT_MODEL=
RECEIPT_TIMEOUT_SECONDS=45

# Production SMTP provider: set its host, credentials and verified sender.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=5
EMAIL_VERIFICATION_REQUIRED=false

# PostgreSQL counters shared across workers; also enforce per-client limits at ingress.
RATE_WINDOW_SECONDS=900
RATE_LOGIN=20
RATE_REGISTRATION=20
RATE_PASSWORD_RESET=5
RATE_RESET_CONFIRM=10
RATE_VERIFICATION=5
RATE_INVITATIONS=10
RATE_EXTRACTION=10
RATE_ACCOUNT=5
